# Copiar a .env.local con los valores reales. Todas las EXPO_PUBLIC_* son públicas (viajan dentro del APK).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MS_CLIENT_ID=
# Opcional: sin ella no aparece "Vincular Gmail".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Solo scripts de desarrollo (dev:link-outlook, dev:link-gmail, dev:sync, dev:download-eml). No son EXPO_PUBLIC.
# DEV_USER_EMAIL=
# DEV_USER_PASSWORD=
# SYNC_MAIL_SECRET=
