{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "expo/types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "app",
    "src",
    "scripts",
    "tests",
    "supabase/functions/_shared/parsers",
    "nativewind-env.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/test-helpers.ts"]
}
