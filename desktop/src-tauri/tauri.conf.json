{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recibo",
  "version": "0.1.0",
  "identifier": "do.recibo.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Recibo", "visible": false, "width": 1100, "height": 760, "minWidth": 900, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co http://127.0.0.1:54321; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMkZBQUU3MzAyQkVFQUIKUldTcjdpc3c1Nm92RUJhTklORjgwNFNNd2drV2l2M1htemYwRDlEWnNFdzZBQmZNODhDWGtoK0kK",
      "endpoints": ["https://github.com/Oct4vius/Recibo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
