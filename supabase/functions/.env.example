# Copiar a supabase/functions/.env para `bun run functions:serve`. En el remoto: supabase secrets set.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
SYNC_MAIL_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Cliente Web de Google Cloud (el mismo que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID)
GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cambia-esto
