{
  "name": "gastos-app",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:deno": "deno test --allow-read supabase/functions/",
    "lint": "deno lint supabase/functions/ && expo lint",
    "check": "bun run typecheck && bun run test && bun run test:deno && bun run lint",
    "fixtures:build": "bun scripts/build-fixtures.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --lang typescript --local --schema public > supabase/functions/_shared/database.types.ts",
    "check:db": "bun run db:reset && bun run db:test",
    "verify:bundle": "expo export --platform android --output-dir .expo-export-check && node -e \"require('fs').rmSync('.expo-export-check',{recursive:true,force:true})\"",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "dev:link-outlook": "bun scripts/dev-link-outlook.ts",
    "dev:link-gmail": "bun scripts/dev-link-gmail.ts",
    "dev:sync": "bun scripts/dev-sync.ts",
    "dev:download-eml": "bun scripts/dev-download-eml.ts",
    "eml:anonymize": "bun scripts/anonymize-eml.ts"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^26.6.1",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "postal-mime": "^3.0.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "aes-js": "^3.1.2",
    "expo": "~57.0.30",
    "expo-auth-session": "~57.0.16",
    "expo-background-task": "~57.0.21",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4"
  }
}
